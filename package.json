{
  "name": "html-to-pdf-api",
  "version": "1.0.0",
  "description": "A Node.js API service that converts HTML to PDF using Puppeteer",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "docker:build": "docker build -t html-to-pdf-api .",
    "docker:run": "docker run -p 3000:3000 html-to-pdf-api"
  },
  "keywords": [
    "html",
    "pdf",
    "puppeteer",
    "api",
    "nodejs",
    "express"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "puppeteer": "^24.17.1",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}